{
    "name": "@repo/ui",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": {
        "./styles.css": "./src/styles/theme.css",
        "./lib/utils": "./src/lib/utils.ts",
        "./hooks/*": "./src/hooks/*.ts",
        "./components/ui/*": "./src/components/ui/*.tsx",
        "./components/form": "./src/components/form/index.ts",
