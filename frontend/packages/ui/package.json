        "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"package.json\""
    },
    "prettier": "@repo/prettier-config",
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "tailwindcss": "^4.0.0"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@tanstack/react-form": "^1.33.5",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.5.2",
        "lucide-react": "^1.77.0"
    },
    "devDependencies": {
        "@repo/eslint-config": "*",
        "@repo/prettier-config": "*",
        "@repo/typescript-config": "*",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^10.15.0",
        "prettier": "^3.10.1",
        "typescript": "^5"
    }
}
