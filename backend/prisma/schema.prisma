// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum refresh_token_status {
    ACTIVE
    USED
    REVOKED
}
enum counselors_approved_status {
    PENDING
    APPROVED
    REJECTED
}

model refresh_tokens {
    jti        String               @id @db.Uuid
    family     String               @db.Uuid
    expires_at DateTime
    status     refresh_token_status @default(ACTIVE)
}

model users {
    id                Int       @id @default(autoincrement())
    first_name        String    @db.VarChar(150)
    last_name         String    @db.VarChar(150)
    created_at        DateTime  @default(now())
    updated_at        DateTime  @updatedAt
    email             String    @unique @db.VarChar(255)
    email_verified_at DateTime?
    hashed_password   String?   @db.VarChar(255)

    // one on one with the Internal table
    internals internals?

    // one on one with the Counselor table
    counselors counselors?

    // one on one with the Patient table
    patients patients?

}

model internals {
    id Int @id @default(autoincrement())

    // one on one with the User table
    user_id Int   @unique
    users   users @relation(fields: [user_id], references: [id], onDelete: Cascade)
}
enum document_type{
    CIN 
    CV 
    MEDICAL_CERTIFICATE
}

model document_types {
    id   Int    @id @default(autoincrement())
    name String @unique

    documents counselor_documents[]
}

model counselor_documents {
    id Int @id @default(autoincrement())

    counselor_id Int
    counselor    counselors @relation(fields: [counselor_id], references: [id], onDelete: Cascade)

    document_type_id Int
    document_type    document_types @relation(fields: [document_type_id], references: [id])

    file_name String
    file_path String
    mime_type String
    file_size Int

    uploaded_at DateTime @default(now())

    @@unique([counselor_id, document_type_id])
}

model counselors {
    id Int @id @default(autoincrement())

    // one on one with the User table
    user_id Int   @unique
    users   users @relation(fields: [user_id], references: [id], onDelete: Cascade)

    // Documents uploaded by the counselor
    documents counselor_documents[]

    status   counselors_approved_status @default(PENDING)
    feedback String?                    @db.Text
}

model patients {
    id Int @id @default(autoincrement())

    // one on one with the User table
    user_id Int  @unique
    users    users @relation(fields: [user_id], references: [id], onDelete: Cascade)
}
